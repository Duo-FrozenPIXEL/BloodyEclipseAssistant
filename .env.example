# Kopieren nach .env und ausfüllen. Die .env wird nie committet.

# --- Untis ---
UNTIS_SERVER=            # z. B. nessa.webuntis.com (ohne https://)
UNTIS_SCHOOL=            # Schulkürzel aus der WebUntis-URL
UNTIS_USER=
UNTIS_PASSWORD=

# --- Google ---
GOOGLE_CREDENTIALS_FILE=secrets/credentials.json   # OAuth-Client (Typ "Desktop-App")
GOOGLE_TOKEN_FILE=secrets/token.json               # wird beim ersten Login erzeugt
GOOGLE_CALENDAR_NAME=Untis 🌑                      # Kalender, den der Assistent selbst anlegt

# --- Verhalten ---
BEA_TIMEZONE=Europe/Berlin
BEA_SYNC_DAYS_AHEAD=14
BEA_SYNC_INTERVAL_MINUTES=10
BEA_CANCELLED_MODE=mark          # mark = als "Entfällt" behalten | delete = Termin löschen

# --- Sprache ---
BEA_VOICE=de_DE-thorsten-high
BEA_VOICE_DIR=voices
BEA_BRIEFING_TIME=06:45
BEA_QUIET_HOURS=21:30-06:30
